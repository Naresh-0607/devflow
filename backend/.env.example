# App
APP_NAME=DevFlow
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Neon in production). Leave unset for local SQLite.
# DATABASE_URL=postgresql+asyncpg://user:password@host/db?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./devflow.db
SQL_ECHO=false

# Auth. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI layer (LiteLLM). Missing key => deterministic local summaries.
GROQ_API_KEY=
LLM_MODEL=groq/llama-3.3-70b-versatile
